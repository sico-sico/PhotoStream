{
  "name": "photostream",
  "version": "0.2.2",
  "description": "Desktop photo wall: free panning, wheel zoom, filters, single-photo viewer",
  "main": "./out/main/index.js",
  "author": "sico-sico",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "config": {
    "electron_mirror": "https://registry.npmmirror.com/-/binary/electron/"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run test:coverage && npm run test:e2e",
    "dist": "electron-vite build && node scripts/package.mjs",
    "icon": "node scripts/make-icon.mjs",
    "smoke:portable": "node scripts/smoke-portable.mjs release/PhotoStream-portable-win-x64",
    "verify:library": "node --import tsx scripts/verify-library.ts",
    "bench": "node --import tsx scripts/bench/index.ts",
    "bench:all": "npm run build && node --import tsx scripts/bench/index.ts --large --app",
    "bench:update": "node --import tsx scripts/bench/index.ts --update",
    "bench:all:update": "npm run build && node --import tsx scripts/bench/index.ts --large --app --update"
  },
  "dependencies": {
    "exif-reader": "^2.0.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.9.0",
    "electron-vite": "^6.0.0",
    "image-size": "^2.0.4",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
